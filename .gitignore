# Python environments, bytecode, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local credentials and environment configuration
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# Raw/processed datasets are excluded by default to keep the repository small.
# They are third-party CC BY-SA 4.0 content; see DATASET_ATTRIBUTION.md before
# tracking any file, and keep the attribution and change notes with it.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models are generated locally and are not committed; preserve directory marker.
models/*
!models/.gitkeep

# Common local editor/OS files
.DS_Store
