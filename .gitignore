# Python environments, bytecode, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local credentials and environment configuration
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# Raw data: the four dataset files and their attribution note are versioned.
# Everything else in data/raw/ stays local. The tracked files are third-party
# CC BY-SA 4.0 content; see DATASET_ATTRIBUTION.md before changing them.
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
!data/raw/dataset.csv
!data/raw/Symptom-severity.csv
!data/raw/symptom_Description.csv
!data/raw/symptom_precaution.csv
data/processed/*
!data/processed/.gitkeep

# Models are generated locally and are not committed; preserve directory marker.
models/*
!models/.gitkeep

# Common local editor/OS files
.DS_Store
