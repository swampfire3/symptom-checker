# Python environments, bytecode, and test output
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local credentials and environment configuration
.env
.env.*
!.env.example
.secrets/
*.pem
*.key

# Raw/processed datasets remain excluded until source and redistribution rights
# are confirmed for every included file. To track approved files later, change
# these rules deliberately and document the applicable attribution/license.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Models are generated locally and are not committed; preserve directory marker.
models/*
!models/.gitkeep

# Common local editor/OS files
.DS_Store
